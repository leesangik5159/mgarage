# ============================================
# M.garage 환경변수 예시 파일
# 이 파일을 복사해서 ".env.local" 이름으로 저장한 뒤
# 아래 값들을 실제 발급받은 값으로 채워 넣으세요.
# .env.local 파일은 절대 깃허브에 올리지 마세요 (.gitignore에 이미 포함되어 있음)
# ============================================

# --- Supabase (프로젝트 설정 > API 메뉴에서 확인) ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=여기에_service_role_키_붙여넣기

# --- 토스페이먼츠 (개발자센터 > API 키 메뉴에서 확인) ---
# 아래 값은 토스페이먼츠가 공식적으로 제공하는 "문서용 테스트 키"입니다.
# 회원가입/사업자등록 없이 바로 결제 테스트가 가능하지만, 실제 카드가 결제되지는 않습니다.
# 나중에 토스페이먼츠 가입 후에는 개발자센터에서 발급받은 "내 테스트 키"로 바꾸는 것을 권장하고,
# 사업자등록 + 심사가 끝나면 live_ck_... / live_sk_... 로 시작하는 라이브 키로 교체하세요.
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_D5GePWvyJnrK0W0k6q8gLzN97Eoq
TOSS_SECRET_KEY=test_sk_zXLkKEypNArWmo50nX3lmeaxYG5R

# --- 관리자 페이지 로그인 비밀번호 (직접 정하세요) ---
ADMIN_PASSWORD=원하는_관리자_비밀번호
# 아래 값은 임의의 긴 문자열로 한 번만 정해서 그대로 사용하세요 (로그인 세션 서명용)
ADMIN_SESSION_SECRET=아무거나_긴_임의의_문자열로_변경하세요

# --- 사이트 주소 (배포 후 Vercel에서 받은 주소로 변경) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
